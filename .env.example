# ASI:One (OpenAI-compatible). Put your key here, never in code or chat.
ASI_ONE_API_KEY=
ASI1_BASE_URL=https://api.asi1.ai/v1
# asi1 (default, reasoning) · asi1-mini (cheaper, faster) · asi1-ultra
ASI1_MODEL=asi1

# Stripe test mode (sk_test_ / pk_test_). Leave empty to simulate payments.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Strata backend: the mock server now, Base44 function URLs later.
STRATA_API_URL=http://127.0.0.1:8090
STRATA_API_SECRET=change-me
# Public HTTPS origin that serves preview PNGs to ASI:One (e.g. a cloudflared tunnel to :8090).
PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com

# Demo mapping of the ASI:One user to a Strata member and file.
STRATA_DEMO_MEMBER=alex
STRATA_DEMO_FILE=fintech-landing

# One seed per agent = stable agent1q... addresses. Use long random strings and keep them secret.
CONCIERGE_SEED=
CURATOR_SEED=
RENDERER_SEED=
CHECKOUT_SEED=
LEDGER_SEED=

# Base44 (set STRATA_BACKEND=base44 once the app's agentApi function is published)
STRATA_BACKEND=mock
BASE44_APP_URL=
BASE44_APP_ID=
# Personal access token (Workspace Settings → Secrets → Personal access tokens), only for seeding.
BASE44_PAT=

# CREAO agents (agent page → API trigger). Never commit real values.
CREAO_CURATOR_APP_ID=
CREAO_CURATOR_KEY=
CREAO_TEAMMATE_APP_ID=
CREAO_TEAMMATE_KEY=
CREAO_CATCHUP_APP_ID=
CREAO_CATCHUP_KEY=
# 1 = rough local stand-ins for UI work only (labelled in the UI). Leave empty for the real demo.
STRATA_OFFLINE_AGENTS=

# One combined CREAO agent (used for any job without its own keys)
CREAO_STRATA_APP_ID=
CREAO_STRATA_KEY=
